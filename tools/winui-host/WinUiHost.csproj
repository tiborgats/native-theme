<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The WinUI host (D4, spike W): a WinUI 3 app on the release set's Windows App
    SDK, unpackaged and self-contained (the Windows App SDK's runtime is copied
    beside the executable, so the runner needs no installed runtime). It opens a
    window with a Button, a MenuFlyout and a ToolTip, and writes their frames as
    TOML and the window as PNG (App.xaml.cs). Built and run by os-probe.yml's
    winui-host job (run.ps1).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinUiHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>ARM64;x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>
</Project>
