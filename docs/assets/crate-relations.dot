// native-theme workspace — crate relations
//
// Rendered by ./scripts/generate_diagrams.sh (Graphviz `dot -Tsvg`, plus an
// embedded subset of "Fuzzy Bubbles" for the "Your app" label).
//
// Palette: blue = the application, emerald = connectors (pick one), teal =
// optional companion widgets, slate = the runtime core and its internal
// proc-macro, amber = the optional build-time code generator. Crate names
// are monospace bold; the line under each says what it is for. No toolkit
// versions appear here: they live in each connector's README, where a test
// keeps them true.
//
// Edges point from a crate to what it depends on; dashed means optional.

digraph crate_relations {
    rankdir=LR;
    bgcolor="transparent";
    pad=0.35;
    nodesep=0.45;
    ranksep=0.9;
    splines=spline;
    compound=true;
    newrank=true;
    fontname="sans-serif";

    node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=14,
          penwidth=1.8, margin="0.28,0.14"];
    edge [color="#64748b", fontname="sans-serif", fontsize=11, fontcolor="#64748b",
          penwidth=1.8, arrowsize=0.75, arrowhead=vee];

    // The application. "Fuzzy Bubbles" gives it a hand-drawn feel against the
    // clean typography of the crates.
    app [label=<<B>Your app</B>>, shape=box, style="rounded,filled",
         fontsize=18, fontname="Fuzzy Bubbles", margin="0.35,0.22",
         fillcolor="#eff6ff", color="#2563eb", fontcolor="#1e3a8a"];

    // Connectors: the application picks the one for its toolkit.
    subgraph cluster_connectors {
        label=<<FONT POINT-SIZE="12" COLOR="#10b981"><I>pick the connector for your toolkit</I></FONT>>;
        labeljust=l;
        style="rounded,dashed";
        color="#34d399";
        penwidth=1.4;
        margin=14;

        gpui [label=<<FONT FACE="monospace"><B>native-theme-gpui</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#64748b"><I>for gpui-component (GPUI Kit)</I></FONT>>,
              fillcolor="#ecfdf5", color="#059669", fontcolor="#064e3b"];
        iced [label=<<FONT FACE="monospace"><B>native-theme-iced</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#64748b"><I>for iced</I></FONT>>,
              fillcolor="#ecfdf5", color="#059669", fontcolor="#064e3b"];
        egui [label=<<FONT FACE="monospace"><B>native-theme-egui</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#64748b"><I>for egui</I></FONT>>,
              fillcolor="#ecfdf5", color="#059669", fontcolor="#064e3b"];
    }

    // Optional companion of the egui connector: widgets egui lacks, drawn
    // from the theme.
    eguiw [label=<<FONT FACE="monospace"><B>native-theme-egui-widgets</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#64748b"><I>optional · switch, slider, segmented…</I></FONT>>,
           style="rounded,filled,dashed",
           fillcolor="#f0fdfa", color="#0d9488", fontcolor="#134e4a"];

    // Runtime core.
    core [label=<<FONT FACE="monospace" POINT-SIZE="15"><B>native-theme</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#64748b"><I>runtime core · presets<BR/>reads the desktop's theme<BR/>Theme → ResolvedTheme</I></FONT>>,
          margin="0.34,0.16", penwidth=2.4,
          fillcolor="#f1f5f9", color="#64748b", fontcolor="#1e293b"];

    // Internal proc-macro of the core.
    derive [label=<<FONT FACE="monospace"><B>native-theme-derive</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#64748b"><I>proc-macro (internal)</I></FONT>>,
            style="rounded,filled,dashed",
            fillcolor="#f8fafc", color="#94a3b8", fontcolor="#475569"];

    // Optional build-time code generator for custom icon roles.
    build [label=<<FONT FACE="monospace"><B>native-theme-build</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#64748b"><I>optional · build.rs<BR/>custom icon codegen</I></FONT>>,
           style="rounded,filled,dashed",
           fillcolor="#fffbeb", color="#d97706", fontcolor="#78350f"];

    // Columns: app | companion widgets, build | connectors | core, derive.
    { rank=same; gpui -> iced -> egui [style=invis]; }
    { rank=same; eguiw -> build [style=invis]; }
    { rank=same; core; derive; }

    app -> iced [lhead=cluster_connectors, minlen=2];
    app -> eguiw [style=dashed];
    app -> build [style=dashed, xlabel="build-dependency"];

    eguiw -> egui;

    gpui -> core;
    iced -> core;
    egui -> core;

    core -> derive [style=dashed];
}
